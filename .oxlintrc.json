{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "overrides": [
    {
      "files": ["src/lib/index.ts"],
      "rules": {
        "unicorn/no-empty-file": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}